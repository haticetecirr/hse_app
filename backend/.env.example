# PostgreSQL baglantisi (docker-compose host portu 5433)
DATABASE_URL="postgresql://hse:hse_password@localhost:5433/hse_db?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="1d"

# Sunucu
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# MinIO (nesne depolama - docker-compose ile ayni)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="hse_minio"
MINIO_SECRET_KEY="hse_minio_password"
MINIO_BUCKET="hse-uploads"

# Onceden tanimli super admin (ilk seed'de olusturulur)
SUPER_ADMIN_EMAIL="admin@hse.local"
SUPER_ADMIN_PASSWORD="Admin123!"
SUPER_ADMIN_NAME="Sistem Yoneticisi"
